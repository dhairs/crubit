module(
    name = "rules_crubit_examples_bzlmod",
    version = "0.0.1",
)

bazel_dep(name = "rules_crubit", version = "0.0.1")

local_path_override(
    module_name = "rules_crubit",
    path = "../..",
)

bazel_dep(name = "rules_rust", version = "0.68.1")
bazel_dep(name = "rules_cc", version = "0.2.8")
bazel_dep(name = "toolchains_llvm", version = "1.5.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    dev_components = True,
    versions = ["nightly/2025-11-20"],
)


llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
# We install this toolchain to provide access, but in doing so it also becomes our cc_toolchain.
# Being our cc_toolchain means we need this to be a version of LLVM that's compatible with our Rust toolchain, so we pin to a specific version from github (rather than rely on the versions provided by default in the rules).
llvm.toolchain(
   llvm_version = "21.1.8",
   extra_llvm_distributions = {
     "clang+llvm-21.1.8-x86_64-pc-windows-msvc.tar.xz": "749d22f565fcd5718dbed06512572d0e5353b502c03fe1f7f17ee8b8aca21a47",
     "LLVM-21.1.8-Linux-ARM64.tar.xz": "65ce0b329514e5643407db2d02a5bd34bf33d159055dafa82825c8385bd01993",
     "LLVM-21.1.8-Linux-X64.tar.xz": "b3b7f2801d15d50736acea3c73982994d025b01c2f035b91ae3b49d1b575732b",
     "LLVM-21.1.8-macOS-ARM64.tar.xz": "b95bdd32a33a81ee4d40363aaeb26728a26783fcef26a4d80f65457433ea4669",
   }
)

use_repo(llvm, "llvm_toolchain")

register_toolchains(
  "@llvm_toolchain//:all",
)
